{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tianshu plugin.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "version", "abi"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "readme": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+\\.(md|txt|markdown)$"
    },
    "icon": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+\\.(png|svg|webp|jpg|jpeg)$"
    },
    "version": { "type": "string", "minLength": 1 },
    "abi": { "type": "integer", "const": 3 },
    "$schema": { "type": "string" }
  }
}
